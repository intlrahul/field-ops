            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE or INSPECTION_READ_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "INVALID_REQUEST (body too large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Updated inspection; identical start/PUT may return unchanged resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./assets-inspections.openapi.json#/components/schemas/InspectionDetail"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingValueInput"
              }
            }
          }
        }
      }
    },
    "/inspections/{id}/notes": {
      "post": {
        "operationId": "addInspectionNote",
        "description": "Assigned technician only. Active session required. Work requires in_progress; completed inspections are read-only. All responses use Cache-Control: no-store. Append-only. Retrying can create duplicate notes; no idempotency key yet.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (supervisor cannot submit technician work)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (missing or inaccessible resource)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE or INSPECTION_READ_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "INVALID_REQUEST (body too large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Note appended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./assets-inspections.openapi.json#/components/schemas/Note"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ChecklistResultInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              null
            ],
            "nullable": true
          },
          "failureNote": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "ReadingValueInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "number"
          }
        }
      },
      "NoteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
