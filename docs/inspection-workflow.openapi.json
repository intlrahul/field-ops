{
  "openapi": "3.0.3",
  "info": {
    "title": "FieldOps inspection workflow",
    "version": "0.4.0",
    "description": "Online workflow API. No sync engine, mutation conflict detection, or general POST retry guarantee yet."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/inspections/{id}/start": {
      "post": {
        "operationId": "startInspection",
        "description": "Assigned technician only. Active session required. Work requires in_progress; completed inspections are read-only. All responses use Cache-Control: no-store. assigned transitions to in_progress; repeated start while in_progress is a no-op.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (supervisor cannot submit technician work)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (missing or inaccessible resource)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE or INSPECTION_READ_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "INVALID_REQUEST (body too large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Updated inspection; identical start/PUT may return unchanged resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./assets-inspections.openapi.json#/components/schemas/InspectionDetail"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        }
      }
    },
    "/inspections/{id}/complete": {
      "post": {
        "operationId": "completeInspection",
        "description": "Assigned technician only. Active session required. Work requires in_progress; completed inspections are read-only. All responses use Cache-Control: no-store. Checks persisted answers/readings and completes in one transaction; no waiver for out-of-range values.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN (supervisor cannot submit technician work)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (missing or inaccessible resource)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE or INSPECTION_READ_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "INVALID_REQUEST (body too large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "COMPLETION_BLOCKED; error.details.blockers identifies each unmet requirement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Updated inspection; identical start/PUT may return unchanged resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./assets-inspections.openapi.json#/components/schemas/InspectionDetail"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        }
      }
    },
    "/inspections/{id}/checklist-items/{itemId}/result": {
      "put": {
        "operationId": "setChecklistResult",
        "description": "Assigned technician only. Active session required. Work requires in_progress; completed inspections are read-only. All responses use Cache-Control: no-store. null clears an answer. A failed result may omit an explanation while drafting but blocks completion. Non-failed results cannot have a nonblank failureNote. PUT replaces the result and explanation.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
