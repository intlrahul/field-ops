              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE or INSPECTION_READ_ONLY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "INVALID_REQUEST (body too large)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./openapi.yaml#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Updated inspection; identical start/PUT may return unchanged resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./assets-inspections.openapi.json#/components/schemas/InspectionDetail"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChecklistResultInput"
              }
            }
          }
        }
      }
    },
    "/inspections/{id}/readings/{readingId}": {
      "put": {
        "operationId": "setReadingValue",
        "description": "Assigned technician only. Active session required. Work requires in_progress; completed inspections are read-only. All responses use Cache-Control: no-store. Finite JSON number only. Out-of-range values are saved. Latest value replaces current display; earlier distinct values remain in internal history. Identical latest values are no-ops.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "readingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
